# Public browser configuration (bundled into client code)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_SENTRY_DSN=

# Deployment identity
APP_ENV=development
APP_VERSION=2.0.0
BUILD_ID=local
GIT_COMMIT_SHA=local

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_STORAGE_KEY=replace-with-server-only-storage-key

# Provider placeholders — leave empty until an integration is approved
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
# Active transactional provider: resend, sendgrid, postmark, or smtp
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=VAYON
EMAIL_PAYLOAD_ENCRYPTION_KEY=
EMAIL_PROCESSOR_SECRET=
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/microsoft/callback
MICROSOFT_TOKEN_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# Observability placeholders — providers remain disconnected
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vayon-web
LOG_LEVEL=info

# Local deployment defaults for feature contracts
FEATURE_AI=false
FEATURE_GMAIL=false
FEATURE_WHATSAPP=false
FEATURE_STRIPE=false
FEATURE_BETA=false
FEATURE_VAYON_INTELLIGENCE=false
FEATURE_GOOGLE_IDENTITY=false
FEATURE_GOOGLE_CALENDAR=false
FEATURE_GOOGLE_DRIVE=false
FEATURE_GOOGLE_CONTACTS=false
FEATURE_MICROSOFT_IDENTITY=false
FEATURE_WORKFLOW_RUNTIME=false
TRUSTED_ORIGINS=http://localhost:3000
